{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    // Os arquivos em src/ não usam import/export: são scripts clássicos que
    // compartilham o escopo global. Assim o index.html abre direto via file://,
    // sem servidor (ES modules são bloqueados por CORS em file://).
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
